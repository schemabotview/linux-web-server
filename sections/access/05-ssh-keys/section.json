{
 "vm": "laptop",
 "with": ["web-01"],
 "session": [
  "ls -la ~/.ssh",
  {"type": "ssh-keygen -t ed25519 -C ana@laptop",
   "answer": [["save the key \\(.*\\): $", ""], ["passphrase.*: $", ""], ["again: $", ""]]},
  "ls -l ~/.ssh",
  "cat ~/.ssh/id_ed25519.pub",
  {"type": "ssh-copy-id ana@192.0.2.10",
   "answer": [["fingerprint\\]\\)\\? $", "yes"], ["password: $", "@password"]]},
  "ssh ana@192.0.2.10",
  "cat ~/.ssh/authorized_keys",
  "ls -ld ~/.ssh ~/.ssh/authorized_keys",
  "exit"
 ]
}
